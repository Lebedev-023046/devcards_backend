generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id       String @id @default(uuid())
  name     String @default("")
  email    String @unique
  password String
  role     Role   @default(USER)
  decks    Deck[] @relation("UserDecks")

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  userCardStatus UserCardStatus[]
  favoriteDecks  FavoriteDeck[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique()
  deckTags DeckTag[]
}

model DeckTag {
  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId String

  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId String

  @@id([deckId, tagId])
}

model Deck {
  id            String  @id @default(uuid())
  title         String
  description   String  @default("")
  isPublic      Boolean @default(true)
  coverImageUrl String  @default("")

  totalCards Int @default(0)

  owner   User   @relation("UserDecks", fields: [ownerId], references: [id])
  ownerId String

  views        Int @default(0) // total views
  totalReviews Int @default(0) // total reviews

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards         Card[]
  favoriteDecks FavoriteDeck[]
  deckTags      DeckTag[]
}

model FavoriteDeck {
  id        String   @id @default(cuid())
  userId    String
  deckId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([userId, deckId])
}

enum CardType {
  SINGLE_CHOICE
  MULTI_CHOICE
  // AI_ANSWER
  INFO
}

model Card {
  id       String @id @default(uuid())
  question String

  type CardType @default(SINGLE_CHOICE)

  // Для INFO, AI_ANSWER, TEXT_ANSWER
  answer String? // текстовый ответ или пояснение

  //  Для CHOICE
  options Option[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  userCardStatus UserCardStatus[]

  deck   Deck   @relation(fields: [deckId], references: [id])
  deckId String
}

model Option {
  id        String  @id @default(uuid())
  text      String
  isCorrect Boolean

  card   Card   @relation(fields: [cardId], references: [id])
  cardId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserCardStatus {
  id             String   @id @default(cuid())
  userId         String
  cardId         String
  correctCount   Int      @default(0)
  attemptCount   Int      @default(0)
  lastReviewedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  card Card @relation(fields: [cardId], references: [id])

  @@unique([userId, cardId])
}
